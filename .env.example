# ============================================
# VARIABLES D'ENVIRONNEMENT - PORTFOLIO
# ============================================
# Sur alwaysdata : colle ces lignes (avec tes vraies valeurs)
# dans Sites > Configuration > Environnement
# Format attendu par alwaysdata : NOM=valeur NOM2=valeur2 (sur une seule ligne, séparés par espace)

# Port (alwaysdata le fournit automatiquement, ne pas changer en prod)
PORT=8100

# Secret pour les sessions (admin catalogues, hash IP votes). Mets une longue chaîne aléatoire.
SESSION_SECRET=change-moi-en-une-longue-phrase-aleatoire-secrete

# Secret de chiffrement pour les projets Notes élèves et Bloc-notes (AES-256).
# IMPORTANT : si tu changes cette valeur après coup, les anciens fichiers .pibody deviendront illisibles.
ENCRYPTION_SECRET=change-moi-aussi-une-autre-longue-phrase-secrete

# Mots de passe admin — un par catalogue (page d'accès cachée : /projets/boutique/gestion-privee-pibody)
# Choisis 3 mots de passe différents, un pour chaque espace.
ADMIN_PASSWORD_BOUTIQUE=change-moi-1
ADMIN_PASSWORD_ECOMMERCE=change-moi-2
ADMIN_PASSWORD_RESTAURANT=change-moi-3
# Mot de passe de secours générique si l'un des trois n'est pas défini (évite un blocage total)
ADMIN_PASSWORD=change-moi

# Email - SMTP alwaysdata (pour le formulaire de contact)
EMAIL_HOST=smtp-pibody.alwaysdata.net
EMAIL_PORT=587
EMAIL_USER=pibody@alwaysdata.net
EMAIL_PASSWORD=colle-le-mot-de-passe-de-la-boite-mail
EMAIL_TO=elfriedzannou@gmail.com

# IA Pibody + Quiz IA (Arcade) - clés API GRATUITES
# Au moins une recommandée, sinon le chat Pibody IA et le Quiz IA répondent une erreur claire
# (le reste du site fonctionne normalement sans elles).
# Groq : https://console.groq.com (gratuit, génère une clé dans "API Keys")
GROQ_API_KEY=

# Gemini : https://aistudio.google.com/app/apikey (gratuit)
GEMINI_API_KEY=

# Mistral : https://console.mistral.ai (offre gratuite "La Plateforme")
MISTRAL_API_KEY=
