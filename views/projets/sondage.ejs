<%- include('../partials/back-button') %>

<section class="projet-page">
  <div class="container">
    <div class="projet-header">
      <div class="projet-eyebrow">Projet — Recherche</div>
      <h1 class="projet-title">Questionnaire d'enquête</h1>
      <p class="projet-desc">Créez un sondage, partagez le lien, suivez les réponses arriver en direct sur un graphique.</p>
    </div>

    <div class="projet-panel glass" style="max-width:700px;">
      <div class="field-row"><label>Titre du sondage</label><input type="text" id="sondageTitre" placeholder="Ex: Satisfaction utilisateurs"></div>

      <h3 style="margin:20px 0 10px;">Questions</h3>
      <div id="questionsContainer"></div>
      <button class="btn btn-ghost" id="addQuestionBtn" style="margin-top:10px;"><i class="fa-solid fa-plus"></i> Ajouter une question</button>

      <button class="btn btn-primary btn-block" id="createBtn" style="margin-top:20px;"><i class="fa-solid fa-rocket"></i> Créer le sondage</button>
      <div id="resultLinks" style="margin-top:20px;"></div>
    </div>
  </div>
</section>

<script>
  const container = document.getElementById('questionsContainer');

  function addQuestion(texte = '', type = 'choix', options = ['', '']) {
    const div = document.createElement('div');
    div.className = 'projet-panel glass q-block';
    div.style.marginBottom = '14px';
    div.innerHTML = `
      <div class="field-row"><label>Question</label><input type="text" class="q-texte" value="${texte}" placeholder="Votre question"></div>
      <div class="field-row"><label>Type</label>
        <select class="q-type">
          <option value="choix" ${type==='choix'?'selected':''}>Choix multiple</option>
          <option value="echelle" ${type==='echelle'?'selected':''}>Échelle (1-5)</option>
          <option value="texte" ${type==='texte'?'selected':''}>Texte libre</option>
        </select>
      </div>
      <div class="q-options-wrap">
        <div class="q-options"></div>
        <button type="button" class="btn btn-ghost add-opt-btn" style="margin-top:6px;"><i class="fa-solid fa-plus"></i> Option</button>
      </div>
      <button type="button" class="btn btn-ghost remove-q-btn" style="margin-top:10px;"><i class="fa-solid fa-trash"></i> Supprimer</button>
    `;
    const optsDiv = div.querySelector('.q-options');
    function addOpt(val) {
      const row = document.createElement('input');
      row.type = 'text'; row.className = 'q-option'; row.value = val; row.placeholder = 'Option';
      row.style.marginTop = '6px'; row.style.width = '100%'; row.style.padding = '10px'; row.style.borderRadius = '8px';
      row.style.border = '1px solid var(--border-glass)'; row.style.background = 'var(--bg-secondary)'; row.style.color = 'var(--text-primary)';
      optsDiv.appendChild(row);
    }
    options.forEach(addOpt);

    function toggleOptionsVisibility() {
      const t = div.querySelector('.q-type').value;
      div.querySelector('.q-options-wrap').style.display = t === 'choix' ? 'block' : 'none';
    }
    div.querySelector('.q-type').addEventListener('change', toggleOptionsVisibility);
    toggleOptionsVisibility();

    div.querySelector('.add-opt-btn').addEventListener('click', () => addOpt(''));
    div.querySelector('.remove-q-btn').addEventListener('click', () => div.remove());
    container.appendChild(div);
  }

  document.getElementById('addQuestionBtn').addEventListener('click', () => addQuestion());
  addQuestion('Êtes-vous satisfait ?', 'choix', ['Oui', 'Non']);

  document.getElementById('createBtn').addEventListener('click', async () => {
    const titre = document.getElementById('sondageTitre').value;
    const questions = Array.from(document.querySelectorAll('.q-block')).map(block => {
      const type = block.querySelector('.q-type').value;
      const texte = block.querySelector('.q-texte').value;
      const options = type === 'choix' ? Array.from(block.querySelectorAll('.q-option')).map(i => i.value).filter(Boolean) : (type === 'echelle' ? ['1','2','3','4','5'] : []);
      return { texte, type, options };
    }).filter(q => q.texte);

    if (!titre || !questions.length) { alert('Titre et au moins une question requis.'); return; }

    const res = await fetch('/projets/sondage/creer', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ titre, questions })
    });
    const data = await res.json();
    if (data.success) {
      const baseUrl = window.location.origin;
      document.getElementById('resultLinks').innerHTML = `
        <div class="result-box">
          <div class="result-label">Lien à partager (réponses) :</div>
          <div class="result-value" style="font-size:1rem; word-break:break-all;">${baseUrl}/projets/sondage/repondre/${data.code}</div>
        </div>
        <a href="/projets/sondage/resultats/${data.code}" class="btn btn-primary btn-block" style="margin-top:14px;"><i class="fa-solid fa-chart-bar"></i> Voir les résultats en direct</a>
      `;
    } else {
      alert(data.error || 'Erreur lors de la création.');
    }
  });
</script>
